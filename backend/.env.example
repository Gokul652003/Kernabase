# Kernabase backend configuration.
#
# Copy to `.env` for local development (`npm start` loads it via dotenv).
# Real environment variables always take precedence over this file.
# Every value below is optional EXCEPT the two secrets, which are required in production.
#
# Running with docker compose? Use the .env.example in the repository root instead —
# compose passes variables into the container and ignores this file.

# ─────────────────────────────────────────────────────────────────────────────
# Required in production (the app refuses to boot without them when NODE_ENV=production)
# ─────────────────────────────────────────────────────────────────────────────

# Signs studio session tokens. Changing it logs everyone out.
# Generate with: openssl rand -base64 48
STUDIO_JWT_SECRET=dev-only-change-me-jwt-secret

# Encrypts stored project database passwords (AES-256-GCM).
# CHANGING THIS MAKES EVERY SAVED PROJECT PASSWORD UNREADABLE — rotate deliberately.
# Generate with: openssl rand -base64 48
STUDIO_SECRET=dev-only-change-me-encryption-secret

# ─────────────────────────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3001

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Max request body size, in the express `limit` format.
HTTP_BODY_LIMIT=1mb

# How long a studio session lasts (zeit/ms format: 30d, 12h, 45m).
STUDIO_JWT_EXPIRES_IN=30d

# ─────────────────────────────────────────────────────────────────────────────
# Control-plane database — where the studio keeps its OWN data (_studio schema:
# users, projects, encrypted credentials). Not a database you browse in the UI.
#
# Do not point this at a superuser in production; see ARCHITECTURE.md
# ("Control-plane privileges") for the least-privilege role to create.
# ─────────────────────────────────────────────────────────────────────────────

PGHOST=localhost
PGPORT=55432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=mydb

CONTROL_POOL_MAX_CONNECTIONS=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_CONNECTION_IDLE_TIMEOUT_MS=30000

# ─────────────────────────────────────────────────────────────────────────────
# Security
# ─────────────────────────────────────────────────────────────────────────────

# Whether users may add databases on loopback / private / LAN addresses.
#
# false (default) — correct for any shared or internet-facing deployment. Stops one
#   user pointing the server at internal services it can reach but they cannot.
# true            — correct for a single-user or self-hosted install whose databases
#   live on the same machine. Without this, adding localhost:5432 is refused.
#
# Either way, the studio's own metadata database (PGHOST + PGPORT + PGDATABASE above)
# is always refused, as are 0.0.0.0, link-local (169.254.169.254) and multicast.
ALLOW_PRIVATE_DATABASE_HOSTS=true

# Fixed-window rate limits, per instance, per IP. Behind a proxy or with more than one
# replica these are not a shared limit — enforce that at the ingress.
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000

# ─────────────────────────────────────────────────────────────────────────────
# Tenant connections — the pool cache for databases users have connected
# ─────────────────────────────────────────────────────────────────────────────

# Cap on cached pools and on total tenant connections this process may open. The
# effective pool count is min(MAX_POOLS, BUDGET / MAX_CONNECTIONS). Size the budget
# from your PostgreSQL connection limit divided by the number of backend replicas,
# and put PgBouncer in front in production.
TENANT_POOL_MAX_POOLS=100
TENANT_POOL_MAX_CONNECTIONS=3
TENANT_POOL_CONNECTION_BUDGET=300

# Idle pools are closed after this long; the sweeper checks on this interval.
TENANT_POOL_IDLE_TTL_MS=300000
TENANT_POOL_SWEEP_INTERVAL_MS=60000

# ─────────────────────────────────────────────────────────────────────────────
# Query safety limits
# ─────────────────────────────────────────────────────────────────────────────

# Applied as statement_timeout and idle_in_transaction_session_timeout on every
# tenant connection, so one runaway query cannot hold a connection open.
TENANT_STATEMENT_TIMEOUT_MS=15000

# Caps on what a single SQL-editor result may return.
SQL_MAX_ROWS=10000
SQL_MAX_RESPONSE_BYTES=5000000
