# Kernabase — docker compose configuration.
#
#   cp .env.example .env    then edit the three required values below
#   docker compose up -d
#
# Compose reads `.env` from this directory automatically. Compose will refuse to start
# if POSTGRES_PASSWORD, STUDIO_JWT_SECRET or STUDIO_SECRET are missing.
#
# For running the backend directly with `npm start` instead, use backend/.env.example.

# ─────────────────────────────────────────────────────────────────────────────
# Required — no defaults, generate real values
# ─────────────────────────────────────────────────────────────────────────────

# Password for the bundled PostgreSQL container, and what the backend connects with.
POSTGRES_PASSWORD=

# Signs studio session tokens. Changing it logs everyone out.
#   openssl rand -base64 48
STUDIO_JWT_SECRET=

# Encrypts stored project database passwords (AES-256-GCM).
# CHANGING THIS MAKES EVERY SAVED PROJECT PASSWORD UNREADABLE.
#   openssl rand -base64 48
STUDIO_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Optional — shown with their defaults
# ─────────────────────────────────────────────────────────────────────────────

POSTGRES_USER=postgres
POSTGRES_DB=mydb

# Browser origins allowed to call the API. Set this to your real frontend URL when
# you deploy; the default only covers the local Vite dev server.
CORS_ORIGINS=http://localhost:5173

# Whether users may add databases on loopback / private / LAN addresses.
#
# Leave false for anything reachable from the internet: it is what stops one user
# pointing the server at internal services, including other containers on this
# compose network. Set true only for a single-user install.
#
# The studio's own metadata database is refused either way.
ALLOW_PRIVATE_DATABASE_HOSTS=false

# Total tenant database connections this backend may hold open. Size it from your
# PostgreSQL connection limit divided by the number of backend replicas.
TENANT_POOL_CONNECTION_BUDGET=100

# Applied as statement_timeout on every tenant connection.
TENANT_STATEMENT_TIMEOUT_MS=15000
